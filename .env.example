# Backend only — never expose these as NEXT_PUBLIC_* variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-server-secret
HUBSPOT_ACCESS_TOKEN=your-hubspot-app-access-token
ADMIN_API_KEY=replace-with-a-long-random-secret

# Backend CORS allowlist. Set to the deployed frontend origin (frontend URL).
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# Frontend build-time variable — API origin only, not a credential (backend URL).
NEXT_PUBLIC_API_URL=https://your-backend.vercel.app
